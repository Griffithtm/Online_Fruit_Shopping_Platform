<%@ page pageEncoding="UTF-8" %><%@ include file="/WEB-INF/views/header.jsp" %>
<h1>Refunds</h1>
<c:if test="${sessionScope.user.role != 'ADMIN'}"><form method="post" class="panel"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="request"><label>Seller order ID<input type="number" min="1" name="id" required class="form-control"></label><label>Refund or dispute reason<textarea name="reason" maxlength="500" required class="form-control"></textarea></label><button class="button">Request refund review</button></form></c:if>
<c:forEach items="${refunds}" var="t"><section class="panel"><h2><c:out value="${t.order_code}"/> / seller order ${t.seller_order_id}</h2><p><fmt:formatNumber value="${t.amount}"/> VND · <c:out value="${t.method}"/> · <c:out value="${t.status}"/></p><p><c:out value="${t.reason}"/></p><p>Refund type: <c:choose><c:when test="${t.refund_scope == 'EXCESS_PAYMENT'}">Duplicate payment refund</c:when><c:otherwise>Purchase refund</c:otherwise></c:choose></p><p>Evidence: <c:out value="${t.evidence_url}"/></p>
<c:if test="${sessionScope.user.role == 'ADMIN'}"><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${t.id}"><label>Decision reason / manual refund evidence URL<input name="reason" maxlength="500" class="form-control"></label><c:if test="${t.status == 'REQUESTED'}"><button name="action" value="approve" class="button">Approve</button><button name="action" value="reject" class="button">Reject</button></c:if><c:if test="${t.status == 'APPROVED'}"><c:choose><c:when test="${t.method == 'COD'}"><button name="action" value="complete" class="button">Confirm manual refund with evidence</button></c:when><c:otherwise><button name="action" value="online" class="button">Submit VNPay refund</button></c:otherwise></c:choose></c:if><c:if test="${t.status == 'PENDING' && t.method != 'COD'}"><label>Signed VNPay refund response JSON<textarea name="signedResponse" maxlength="65536" class="form-control"></textarea></label><button name="action" value="reconcile" class="button">Verify signed response</button></c:if></form></c:if>
</section></c:forEach><%@ include file="/WEB-INF/views/footer.jsp" %>
