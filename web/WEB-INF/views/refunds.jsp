<%@ page pageEncoding="UTF-8" %><%@ include file="/WEB-INF/views/header.jsp" %>
<h1>Hoàn tiền</h1>
<c:if test="${sessionScope.user.role != 'ADMIN'}"><form method="post" class="panel"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="request"><label>Mã đơn hàng cửa hàng<input type="number" min="1" name="id" required class="form-control"></label><label>Lý do hoàn tiền hoặc khiếu nại<textarea name="reason" maxlength="500" required class="form-control"></textarea></label><button class="button">Gửi yêu cầu hoàn tiền</button></form></c:if>
<c:forEach items="${refunds}" var="t"><section class="panel"><h2><c:out value="${t.orderCode}"/> / đơn cửa hàng ${t.sellerOrderId}</h2><p><fmt:formatNumber value="${t.amount}"/> đ · <c:out value="${vi:label(t.method)}"/> · <c:out value="${vi:label(t.status)}"/></p><p><c:out value="${t.reason}"/></p><p>Loại hoàn tiền: <c:choose><c:when test="${t.refundScope == 'EXCESS_PAYMENT'}">Hoàn khoản thanh toán trùng</c:when><c:otherwise>Hoàn tiền mua hàng</c:otherwise></c:choose></p><p>Bằng chứng: <c:out value="${t.evidenceUrl}"/></p>
        <c:if test="${sessionScope.user.role == 'ADMIN'}"><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${t.id}"><label>Lý do quyết định / đường dẫn bằng chứng hoàn tiền thủ công<input name="reason" maxlength="500" class="form-control"></label><c:if test="${t.status == 'REQUESTED'}"><button name="action" value="approve" class="button">Duyệt</button><button name="action" value="reject" class="button">Từ chối</button></c:if><c:if test="${t.status == 'APPROVED'}"><c:choose><c:when test="${t.method == 'COD'}"><button name="action" value="complete" class="button">Xác nhận hoàn tiền thủ công kèm bằng chứng</button></c:when><c:otherwise><button name="action" value="online" class="button">Gửi yêu cầu hoàn tiền qua VNPay</button></c:otherwise></c:choose></c:if><c:if test="${t.status == 'PENDING' && t.method != 'COD'}"><label>Phản hồi hoàn tiền có chữ ký của VNPay (JSON)<textarea name="signedResponse" maxlength="65536" class="form-control"></textarea></label><button name="action" value="reconcile" class="button">Xác minh phản hồi có chữ ký</button></c:if></form></c:if>
    </section></c:forEach><%@ include file="/WEB-INF/views/footer.jsp" %>
